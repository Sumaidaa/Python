    "#genarate all factors of a number\n",
    "def factors(n):\n",
    "    for i in range(1, n + 1):\n",
    "        if n % i == 0:\n",
    "            print(i)\n",
    "n = int(input(\"enter a number:\"))\n",
    "factors(n)"
